# Copy to .env.development / .env.staging / .env.production (spec §114)
NODE_ENV=development
PORT=3000

# --- Database ---
# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://shogun:shogun@localhost:5432/shogun?schema=public"

# --- Auth / JWT ---
# Secret used to sign access & refresh tokens. MUST be changed per environment.
JWT_SECRET="change-me-in-each-environment"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# --- Cache / queues ---
REDIS_URL="redis://localhost:6379"

# --- Owner super-admin ---
# This account auto-receives Role=OWNER on register/login (see auth.service.ts).
OWNER_EMAIL="jimmyfrgsn95@gmail.com"

# --- CORS ---
# Comma-separated list of allowed browser origins for the API.
# Include the deployed web client and any local dev origins.
CORS_ORIGINS="https://shogun-play.abacusai.cloud,http://localhost:8080,http://localhost:3000"
