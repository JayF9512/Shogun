# Copy to .env.development / .env.staging / .env.production (spec §114)
NODE_ENV=development
PORT=3000
DATABASE_URL="postgresql://shogun:shogun@localhost:5432/shogun?schema=public"
JWT_SECRET="change-me-in-each-environment"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"
REDIS_URL="redis://localhost:6379"
