# Base URL of the NestJS backend (includes the /api global prefix).
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Admin user id used for audit-log attribution on mutating actions.
# In production this is derived from the admin JWT; kept here for local dev.
NEXT_PUBLIC_ADMIN_USER_ID=dev-admin

# Server health placeholder values surfaced on the dashboard.
NEXT_PUBLIC_ENV_TIER=development
